[TITLE]
;;Project: TERRA05 EPA-SWMM Synthetic Benchmark Integration Model
;;Notice: This is a synthetic 2-catchment testbench model for software integration verification.
;;Do NOT treat or calibrate this as a representative model of Mumbai drainage infrastructure.

[OPTIONS]
;;Option             Passed Value
FLOW_UNITS           CMS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
START_DATE           07/26/2005
START_TIME           00:00:00
REPORT_START_DATE    07/26/2005
REPORT_START_TIME    00:00:00
END_DATE             07/26/2005
END_TIME             03:00:00
DRY_DAYS             0
REPORT_STEP          00:15:00
WET_STEP             00:05:00
DRY_STEP             01:00:00
ROUTING_STEP         00:00:30
ALLOW_PONDING        NO
INERTIAL_DAMPING     NONE
VARIABLE_STEP        0.00
LENGTHENING_STEP     0
MIN_SURFAREA         1.167
NORMAL_FLOW_LIMITED  BOTH
SKIP_STEADY_STATE    NO
FORCE_MAIN_EQUATION  H-W
LINK_OFFSETS         DEPTH
MIN_SLOPE            0

[EVAPORATION]
;;Data Source    Parameters
CONSTANT         0.0
DRY_ONLY         NO

[RAINGAGES]
;;Name           Format    Interval SCF      Source    SourceName
RG1              INTENSITY 0:15     1.0      TIMESERIES TS1

[SUBCATCHMENTS]
;;Name           Rain Gage        Outlet           Area     %Imperv  Width    %Slope   CurbLen  SnowPack
S1               RG1              J1               2.5      65       120      0.5      0        
S2               RG1              J2               3.2      80       150      0.4      0        

[SUBAREAS]
;;Subcatchment   N-Imperv   N-Perv     S-Imperv   S-Perv     PctZero    RouteTo    PctRouted 
S1               0.015      0.24       2.0        5.0        25         OUTLET    
S2               0.015      0.24       2.0        5.0        25         OUTLET    

[INFILTRATION]
;;Subcatchment   MaxRate    MinRate    Decay      DryTime    MaxInfil  
S1               75.0       10.0       2.0        7.0        0         
S2               60.0       8.0        2.0        7.0        0         

[JUNCTIONS]
;;Name           Elevation  MaxDepth   InitDepth  SurDepth   Aponded   
J1               14.0       3.0        0.0        0.0        0         
J2               11.5       3.0        0.0        0.0        0         

[OUTFALLS]
;;Name           Elevation  Type       Stage Data       Gated    Route To
O1               9.0        FREE                        NO       

[CONDUITS]
;;Name           From Node        To Node          Length     Roughness  InOffset   OutOffset  InitFlow   MaxFlow   
C1               J1               J2               180        0.013      0          0          0          0         
C2               J2               O1               140        0.013      0          0          0          0         

[XSECTIONS]
;;Link           Shape        Geom1            Geom2      Geom3      Geom4      Barrels    Culvert   
C1               CIRCULAR     1.2              0          0          0          1                    
C2               CIRCULAR     1.5              0          0          0          1                    

[TIMESERIES]
;;Name           Date       Time       Value     
TS1                         00:00      25.0
TS1                         00:15      50.0
TS1                         00:30      100.0
TS1                         00:45      80.0
TS1                         01:00      45.0
TS1                         01:15      20.0
TS1                         01:30      10.0
TS1                         01:45      5.0
TS1                         02:00      0.0
TS1                         03:00      0.0

[REPORT]
;;Element        Action    Units
INPUT            NO
CONTROLS         NO
SUBCATCHMENTS    ALL
NODES            ALL
LINKS            ALL

[TAGS]

[MAP]
DIMENSIONS    276900.000 2110100.000 277400.000 2110400.000
Units         Meters

[COORDINATES]
;;Node           X-Coord            Y-Coord           
J1               277000.000         2110250.000       
J2               277180.000         2110250.000       
O1               277320.000         2110250.000       

[VERTICES]
;;Link           X-Coord            Y-Coord           

[Polygons]
;;Subcatchment   X-Coord            Y-Coord           
S1               276950.000         2110350.000       
S1               277050.000         2110350.000       
S1               277050.000         2110250.000       
S1               276950.000         2110250.000       
S2               277100.000         2110350.000       
S2               277250.000         2110350.000       
S2               277250.000         2110250.000       
S2               277100.000         2110250.000       

[SYMBOLS]
;;Gage           X-Coord            Y-Coord           
RG1              277000.000         2110400.000       
